datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Role {
  ADMIN
  PARTNER
  SELLER
}

enum DeviceStatus {
  MAIN_WAREHOUSE
  STORE_STOCK
  SOLD
  IN_STOCK_AFTER_EXCHANGE
  IN_REPAIR
  TRANSFER_PENDING
}

enum RepairStatus {
  ACCEPTED
  IN_PROGRESS
  READY
  ISSUED
  DIAGNOSTICS
  IN_REPAIR
  DELIVERED
  UNREPAIRABLE
}

enum TransferStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum PaymentMethod {
  CASH
  CARD
  SPLIT
  DEBT
}

enum SaleStatus {
  COMPLETED
  EXCHANGED
  REFUNDED
}

enum BonusType {
  FREE_DEVICES
  CASH_DISCOUNT
}

enum OwnerTransactionType {
  INVESTMENT
  WITHDRAWAL
  PROFIT_PAYOUT
  REINVEST
}

enum LedgerType {
  SALE
  CASH_SALE
  CARD_SALE
  PURCHASE
  EXPENSE
  SALARY
  SUPPLIER_PAYMENT
  OWNER_INVESTMENT
  OWNER_CAPITAL_WITHDRAWAL
  OWNER_PROFIT_PAYOUT
  OWNER_REINVESTMENT
  EXCHANGE_SETTLEMENT
  SUPPLIER_BONUS
  TRANSFER
  REFUND
  CUSTOMER_PAYMENT
}

enum FinancialAccountType {
  CASH
  BANK
  MAIN
  OTHER
}

enum FinancialTransactionType {
  INCOME
  EXPENSE
  TRANSFER
  SUPPLIER_PAYMENT
  OWNER_DEPOSIT
  OWNER_WITHDRAWAL
  REFUND
  ADJUSTMENT
}

// NEUTRAL = TRANSFER/ADJUSTMENT — excluded from income/expense reports so moving
// money between the business's own accounts never shows up as fake revenue/cost.
enum FinancialDirection {
  IN
  OUT
  NEUTRAL
}

enum FinancialTransactionStatus {
  POSTED
  CANCELLED
}

enum CounterpartyType {
  SUPPLIER
  CUSTOMER
  EMPLOYEE
  OWNER
  OTHER
}

// Which of an account's two balance columns (balanceTjs/balanceUsd) a transaction
// actually moved — distinct from `currency`/`amount` (what was paid) because every
// transaction also stores a TJS *and* USD equivalent for reporting, but only one of
// them corresponds to a real account movement. Needed so cancelling a transaction
// reverses the correct balance.
enum LedgerCurrency {
  TJS
  USD
}

model Store {
  id              String   @id @default(uuid())
  name            String
  address         String?
  isMainWarehouse Boolean  @default(false)
  // Every register is kept in USD: TJS takings and payouts are converted at the day's rate.
  cashBalanceUsd  Decimal  @default(0) @db.Decimal(14, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users                 User[]
  devices               Device[]
  sales                 Sale[]
  repairs               RepairTicket[]
  expenses              Expense[]
  transfersFrom         TransferRequest[]      @relation("FromStore")
  transfersTo           TransferRequest[]      @relation("ToStore")
  purchaseInvoices      SupplierInvoice[]
  financialAccount      FinancialAccount?
  financialTransactions FinancialTransaction[]
  cashHandovers         CashHandover[]
  profitShares          StoreProfitShare[]
  storeReceipts         StoreReceipt[]         @relation("ReceiptStore")
  receiptsShipped       StoreReceipt[]         @relation("ReceiptSource")

  @@map("stores")
}

// A store's receipt of phones the admin physically delivered from the main warehouse. The
// store employee scans each IMEI; completing the receipt moves the devices into the store at
// once (no approval step). The admin's acknowledgement only records that it was reviewed.
model StoreReceipt {
  id                   String    @id @default(uuid())
  receiptNumber        String    @unique
  storeId              String
  fromStoreId          String
  createdByUserId      String
  createdByName        String
  itemCount            Int
  createdAt            DateTime  @default(now())
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  acknowledgedByName   String?

  store     Store              @relation("ReceiptStore", fields: [storeId], references: [id])
  fromStore Store              @relation("ReceiptSource", fields: [fromStoreId], references: [id])
  items     StoreReceiptItem[]

  @@index([storeId, createdAt])
  @@index([createdAt])
  @@map("store_receipts")
}

model StoreReceiptItem {
  id        String  @id @default(uuid())
  receiptId String
  deviceId  String
  imei      String
  brand     String
  model     String
  ram       String?
  storage   String
  color     String

  receipt StoreReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  device  Device       @relation(fields: [deviceId], references: [id])

  @@unique([receiptId, deviceId])
  @@index([deviceId])
  @@map("store_receipt_items")
}

// Daily cash handover: the admin collects a store register's whole balance into the
// central register (the main warehouse's). The money itself moves as a TRANSFER in the
// financial ledger; this row is the handover document behind it.
model CashHandover {
  id                     String   @id @default(uuid())
  storeId                String
  amountTjs              Decimal  @db.Decimal(14, 2)
  exchangeRate           Decimal  @db.Decimal(10, 4)
  amountUsd              Decimal  @db.Decimal(14, 2)
  // Business-time-zone day (YYYY-MM-DD) the handover belongs to — drives "handed over today".
  businessDate           String
  acceptedByUserId       String
  acceptedByName         String
  financialTransactionId String   @unique
  createdAt              DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, createdAt])
  @@index([businessDate])
  @@map("cash_handovers")
}

model User {
  id                     String   @id @default(uuid())
  login                  String   @unique
  password               String
  name                   String
  role                   Role     @default(SELLER)
  active                 Boolean  @default(true)
  storeId                String?
  baseSalaryTjs          Decimal? @db.Decimal(14, 2)
  salesCommissionPercent Decimal? @db.Decimal(7, 4)
  pin                    String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  store         Store?         @relation(fields: [storeId], references: [id])
  sales         Sale[]
  repairs       RepairTicket[]
  auditLogs     AuditLog[]
  notifications Notification[]
  ownerProfile  Owner?
  sessions      AuthSession[]
  payrollPayouts PayrollPayout[]

  @@map("users")
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model Device {
  id                String       @id @default(uuid())
  imei              String       @unique
  // A phone's second (dual-SIM) IMEI is a real hardware identifier and must never
  // repeat across devices — nullable @unique gives Postgres a partial unique index
  // that allows unlimited NULLs (most devices have no second slot) while rejecting
  // any duplicate non-null value.
  imei2             String?      @unique
  brand             String
  model             String
  ram               String?
  storage           String
  color             String
  status            DeviceStatus @default(MAIN_WAREHOUSE)
  storeId           String
  purchasePriceUsd  Decimal      @db.Decimal(14, 2)
  costBasisUsd      Decimal      @db.Decimal(14, 2)
  retailPriceTjs    Decimal?     @db.Decimal(14, 2)
  receivedDate      DateTime?
  isBonus           Boolean      @default(false)
  bonusCampaign     String?
  supplierId        String?
  supplierName      String?
  invoiceNumber     String?
  purchaseInvoiceId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  store           Store                 @relation(fields: [storeId], references: [id])
  supplier        Supplier?             @relation(fields: [supplierId], references: [id])
  purchaseInvoice SupplierInvoice?      @relation(fields: [purchaseInvoiceId], references: [id])
  timeline        DeviceTimelineEvent[]
  saleItems       SaleItem[]
  repairTickets   RepairTicket[]
  transferItems   TransferItem[]
  identifiers     DeviceIdentifier[]
  bonusPoolEntries BonusPoolEntry[]
  receiptItems    StoreReceiptItem[]

  @@index([imei])
  @@index([storeId, status])
  @@index([status])
  @@index([createdAt])
  @@index([supplierId])
  @@index([purchaseInvoiceId])
  @@map("devices")
}

model DeviceIdentifier {
  identifier String @id
  deviceId String @map("device_id")
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  @@index([deviceId], map: "device_identifiers_device_idx")
  @@map("device_identifiers")
}

model OperationRequest {
  key String @id
  fingerprint String
  result Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@map("operation_requests")
}

model DeviceTimelineEvent {
  id          String   @id @default(uuid())
  deviceId    String
  date        DateTime @default(now())
  type        String
  description String
  userName    String
  storeName   String?
  priceTjs    Decimal? @db.Decimal(14, 2)
  priceUsd    Decimal? @db.Decimal(14, 2)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("device_timeline_events")
}

model Sale {
  id                       String        @id @default(uuid())
  receiptNumber            Int           @unique @default(autoincrement())
  storeId                  String
  userId                   String
  customerName             String?
  customerId               String?
  totalTjs                 Decimal       @db.Decimal(14, 2)
  totalUsd                 Decimal       @db.Decimal(14, 2)
  exchangeRate             Decimal?      @db.Decimal(10, 4)
  paymentMethod            PaymentMethod
  cashAmountTjs            Decimal       @default(0) @db.Decimal(14, 2)
  cardAmountTjs            Decimal       @default(0) @db.Decimal(14, 2)
  // Amount still owed by the customer on this specific sale — 0 for every normal
  // (fully paid at checkout) sale, so existing sales/reporting are unaffected.
  // Only DEBT-method sales start with this > 0, decremented as CustomerPayments land.
  debtAmountTjs            Decimal       @default(0) @db.Decimal(14, 2)
  exchangeTradeInCreditTjs Decimal?      @db.Decimal(14, 2)
  status                   SaleStatus    @default(COMPLETED)
  hasBelowCostItem         Boolean       @default(false)
  refundReason             String?
  refundedAt               DateTime?
  refundedByUserId         String?
  penaltyFeeTjs            Decimal?      @db.Decimal(14, 2)
  penaltyFeeUsd            Decimal?      @db.Decimal(14, 2)
  actualRefundAmountTjs    Decimal?      @db.Decimal(14, 2)
  createdAt                DateTime      @default(now())

  store              Store                       @relation(fields: [storeId], references: [id])
  user               User                        @relation(fields: [userId], references: [id])
  customer           Customer?                   @relation(fields: [customerId], references: [id])
  saleItems          SaleItem[]
  exchangeEvents     ExchangeEvent[]
  paymentAllocations CustomerPaymentAllocation[]
  bonusPoolEntries   BonusPoolEntry[]

  @@index([storeId, createdAt])
  @@index([customerId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("sales")
}

model SaleItem {
  id              String  @id @default(uuid())
  saleId          String
  deviceId        String
  brand           String
  model           String
  storage         String
  color           String
  imei            String
  imei2           String?
  salePriceTjs    Decimal @db.Decimal(14, 2)
  salePriceUsd    Decimal @db.Decimal(14, 2)
  purchaseCostUsd Decimal @db.Decimal(14, 2)
  costBasisUsd    Decimal @db.Decimal(14, 2)
  isBelowCost     Boolean @default(false)
  isBonus         Boolean @default(false)

  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id])

  @@index([saleId])
  @@index([deviceId])
  @@map("sale_items")
}

model ExchangeEvent {
  id                  String         @id @default(uuid())
  saleId              String
  date                DateTime       @default(now())
  returnedDeviceId    String
  returnedImei        String
  returnedModel       String
  exchangeInValueTjs  Decimal        @db.Decimal(14, 2)
  exchangeInValueUsd  Decimal        @db.Decimal(14, 2)
  replacementDeviceId String
  replacementImei     String
  replacementModel    String
  newPriceTjs         Decimal        @db.Decimal(14, 2)
  newPriceUsd         Decimal        @db.Decimal(14, 2)
  differenceTjs       Decimal        @db.Decimal(14, 2)
  paymentMethod       PaymentMethod?
  cashAmountTjs       Decimal?       @db.Decimal(14, 2)
  cardAmountTjs       Decimal?       @db.Decimal(14, 2)
  exchangeRate        Decimal        @db.Decimal(10, 4)
  processedByUserId   String

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("exchange_events")
}

model Supplier {
  id                String   @id @default(uuid())
  name              String
  phone             String?
  contactPerson     String?
  totalPurchasedUsd Decimal  @default(0) @db.Decimal(14, 2)
  totalPaidUsd      Decimal  @default(0) @db.Decimal(14, 2)
  totalDebtUsd      Decimal  @default(0) @db.Decimal(14, 2)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  devices  Device[]
  invoices SupplierInvoice[]
  bonuses  SupplierBonus[]
  payments SupplierPayment[]

  @@map("suppliers")
}

model SupplierInvoice {
  id              String   @id @default(uuid())
  invoiceNumber   String
  supplierId      String
  date            DateTime @default(now())
  totalAmountUsd  Decimal  @db.Decimal(14, 2)
  exchangeRate    Decimal  @db.Decimal(10, 4)
  paidAmountUsd   Decimal  @default(0) @db.Decimal(14, 2)
  devicesCount    Int      @default(0)
  isStorePurchase Boolean  @default(false)
  storeId         String?

  supplier    Supplier                    @relation(fields: [supplierId], references: [id])
  store       Store?                      @relation(fields: [storeId], references: [id])
  groups      InvoiceGroup[]
  devices     Device[]
  allocations SupplierPaymentAllocation[]

  @@index([supplierId])
  @@index([storeId])
  @@index([date])
  @@map("supplier_invoices")
}

model InvoiceGroup {
  id               String  @id @default(uuid())
  invoiceId        String
  brand            String
  model            String
  ram              String?
  storage          String
  color            String
  quantity         Int
  purchasePriceUsd Decimal @db.Decimal(14, 2)

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_groups")
}

model SupplierPayment {
  id              String   @id @default(uuid())
  supplierId      String
  amountUsd       Decimal  @db.Decimal(14, 2)
  exchangeRate    Decimal  @db.Decimal(10, 4)
  sourceAccount   String
  storeId         String?
  createdByUserId String
  createdAt       DateTime @default(now())

  supplier    Supplier                    @relation(fields: [supplierId], references: [id])
  allocations SupplierPaymentAllocation[]

  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id                 String  @id @default(uuid())
  paymentId          String
  invoiceId          String
  allocatedAmountUsd Decimal @db.Decimal(14, 2)

  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id])

  @@map("supplier_payment_allocations")
}

// A customer is identified by phone number (unique, when provided) rather than
// free-text name alone — the same customer must always resolve to the same record
// across multiple debt sales/payments, so support staff can never end up unsure
// which "Иван" a payment belongs to the way the shop previously had duplicate stores.
model Customer {
  id           String   @id @default(uuid())
  name         String
  phone        String?  @unique
  totalDebtTjs Decimal  @default(0) @db.Decimal(14, 2)
  totalPaidTjs Decimal  @default(0) @db.Decimal(14, 2)
  createdAt    DateTime @default(now())

  sales    Sale[]
  payments CustomerPayment[]

  @@map("customers")
}

model CustomerPayment {
  id              String   @id @default(uuid())
  customerId      String
  amountTjs       Decimal  @db.Decimal(14, 2)
  exchangeRate    Decimal  @db.Decimal(10, 4)
  sourceAccount   String
  storeId         String?
  createdByUserId String
  createdAt       DateTime @default(now())

  customer    Customer                    @relation(fields: [customerId], references: [id])
  allocations CustomerPaymentAllocation[]

  @@index([customerId])
  @@map("customer_payments")
}

model CustomerPaymentAllocation {
  id                 String  @id @default(uuid())
  paymentId          String
  saleId             String
  allocatedAmountTjs Decimal @db.Decimal(14, 2)

  payment CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sale    Sale            @relation(fields: [saleId], references: [id])

  @@index([paymentId])
  @@index([saleId])
  @@map("customer_payment_allocations")
}

model SupplierBonus {
  id            String    @id @default(uuid())
  supplierId    String
  campaignTitle String?
  bonusType     BonusType
  amountUsd     Decimal?  @db.Decimal(14, 2)
  ownerProfitAllocations Json?
  exchangeRate  Decimal   @db.Decimal(10, 4)
  status        String?
  dateReceived  DateTime  @default(now())
  createdAt     DateTime  @default(now())

  supplier    Supplier              @relation(fields: [supplierId], references: [id])
  freeDevices SupplierBonusDevice[]

  @@map("supplier_bonuses")
}

model SupplierBonusDevice {
  id           String  @id @default(uuid())
  bonusId      String
  deviceId     String?
  brand        String
  model        String
  storage      String
  color        String
  imei         String
  costBasisUsd Decimal @db.Decimal(14, 2)

  bonus SupplierBonus @relation(fields: [bonusId], references: [id], onDelete: Cascade)

  @@map("supplier_bonus_devices")
}

enum BonusPoolStatus {
  PENDING
  DISTRIBUTED
  ANNULLED
}

model BonusPoolEntry {
  id               String          @id @default(uuid())
  deviceId         String
  saleId           String?
  saleItemId       String?
  imei             String
  brand            String
  model            String
  salePriceUsd     Decimal         @db.Decimal(14, 2)
  salePriceTjs     Decimal         @db.Decimal(14, 2)
  profitUsd        Decimal         @db.Decimal(14, 2)
  profitTjs        Decimal         @db.Decimal(14, 2)
  status           BonusPoolStatus @default(PENDING)
  distributionId   String?
  distributedAt    DateTime?
  distributedBy    String?
  distributionNote String?
  annulledAt       DateTime?
  annulledBy       String?
  annulledNote     String?
  createdAt        DateTime        @default(now())

  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)
  device Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@map("bonus_pool_entries")
}

model BonusDistributionLog {
  id                String   @id @default(uuid())
  periodName        String
  totalAmountUsd    Decimal  @db.Decimal(14, 2)
  totalAmountTjs    Decimal? @db.Decimal(14, 2)
  type              String   // 'DISTRIBUTION' | 'ANNULMENT'
  allocations       Json
  note              String?
  performedByUserId String
  performedByName   String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@map("bonus_distribution_logs")
}

model TransferRequest {
  id                String         @id @default(uuid())
  transferNumber    String         @unique
  fromStoreId       String
  toStoreId         String
  status            TransferStatus @default(PENDING_APPROVAL)
  requestedByUserId String
  requestedAt       DateTime       @default(now())
  approvedByUserId  String?
  approvedAt        DateTime?
  rejectedReason    String?
  updatedAt         DateTime       @updatedAt

  fromStore Store          @relation("FromStore", fields: [fromStoreId], references: [id])
  toStore   Store          @relation("ToStore", fields: [toStoreId], references: [id])
  items     TransferItem[]

  @@index([fromStoreId])
  @@index([toStoreId])
  @@map("transfer_requests")
}

model TransferItem {
  id         String @id @default(uuid())
  transferId String
  deviceId   String
  imei       String
  brand      String
  model      String

  transfer TransferRequest @relation(fields: [transferId], references: [id], onDelete: Cascade)
  device   Device          @relation(fields: [deviceId], references: [id])

  @@index([transferId])
  @@index([deviceId])
  @@map("transfer_items")
}

model RepairTicket {
  id                 String       @id @default(uuid())
  ticketNumber       Int          @unique @default(autoincrement())
  storeId            String
  userId             String
  deviceId           String?
  imei               String
  imei2              String?
  brand              String
  model              String
  storage            String?
  color              String?
  saleReceiptNumber  Int?
  saleDate           DateTime?
  customerName       String?
  customerPhone      String?
  prepaymentTjs      Decimal?     @db.Decimal(14, 2)
  problemDescription String
  visualCondition    String?
  equipmentPackage   String?
  comment            String?
  status             RepairStatus @default(ACCEPTED)
  estimatedCostTjs   Decimal?     @db.Decimal(14, 2)
  finalCostTjs       Decimal?     @db.Decimal(14, 2)
  // Snapshotted in USD at the moment each cost is actually set (intake quote, final cost),
  // using that day's rate — same pattern as sales/expenses — instead of being recomputed
  // from TJS at read time with whatever rate happens to be current then.
  estimatedCostUsd   Decimal?     @db.Decimal(14, 2)
  finalCostUsd       Decimal?     @db.Decimal(14, 2)
  exchangeRate       Decimal?     @db.Decimal(10, 4)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  store         Store                 @relation(fields: [storeId], references: [id])
  user          User                  @relation(fields: [userId], references: [id])
  device        Device?               @relation(fields: [deviceId], references: [id])
  statusHistory RepairStatusHistory[]

  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@map("repair_tickets")
}

model RepairStatusHistory {
  id              String       @id @default(uuid())
  ticketId        String
  status          RepairStatus
  updatedAt       DateTime     @default(now())
  updatedByUserId String
  note            String?

  ticket RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("repair_status_history")
}

model Expense {
  payrollPayout PayrollPayout?
  id                   String    @id @default(uuid())
  category             String
  amountTjs            Decimal   @db.Decimal(14, 2)
  amountUsd            Decimal?  @db.Decimal(14, 2)
  ownerProfitAllocations Json?
  exchangeRate         Decimal?  @db.Decimal(10, 4)
  targetType           String    @default("STORE")
  storeId              String?
  sourceAccount        String?
  comment              String?
  description          String?
  createdByUserId      String
  paidFromCashRegister Boolean   @default(true)
  // 'PAID' | 'UNPAID' — an expense not written off the store's cash register at creation
  // is recorded as UNPAID and later paid from the register via payExpense.
  status               String    @default("PAID")
  paidAt               DateTime?
  employeeId           String?
  isEmployeeAdvance    Boolean   @default(false)
  // 'YYYY-MM' an employee advance is deducted from (it can be paid out in another month).
  payrollMonth         String?
  createdAt            DateTime  @default(now())
  // Cancellation record instead of a hard delete — the expense (and its financial
  // transaction) must stay queryable forever for audit purposes; see FinancialTransaction.
  cancelledAt          DateTime?
  cancelledByUserId    String?

  store Store? @relation(fields: [storeId], references: [id])

  @@index([storeId, createdAt])
  @@index([createdAt])
  @@index([employeeId])
  @@map("expenses")
}

model PayrollPayout {
  expenseId          String   @id @map("expense_id")
  employeeId         String   @map("employee_id")
  month              String
  grossTjs           Decimal  @map("gross_tjs") @db.Decimal(14, 2)
  previousSalaryTjs   Decimal  @map("previous_salary_tjs") @db.Decimal(14, 2)
  paidAdvancesTjs     Decimal  @map("paid_advances_tjs") @db.Decimal(14, 2)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  expense            Expense  @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  employee           User     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, month], map: "payroll_payouts_employee_month_idx")
  @@map("payroll_payouts")
}

model Owner {
  id                    String   @id @default(uuid())
  // Links this capital/profit record to the actual login account of the business
  // partner it belongs to, so the name is never a manually-copied snapshot that can
  // drift out of sync — nullable because a legacy/silent investor may have no login.
  userId                String?  @unique
  name                  String
  profitSharePercent    Decimal @db.Decimal(7, 4)
  capitalBalanceUsd     Decimal  @default(0) @db.Decimal(14, 2)
  totalAccruedProfitUsd Decimal  @default(0) @db.Decimal(14, 2)
  totalPaidProfitUsd    Decimal  @default(0) @db.Decimal(14, 2)
  totalReinvestedUsd    Decimal  @default(0) @db.Decimal(14, 2)
  availableProfitUsd    Decimal  @default(0) @db.Decimal(14, 2)
  storeId               String?
  createdAt             DateTime @default(now())

  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  transactions OwnerTransaction[]
  storeShares  StoreProfitShare[]

  @@map("owners")
}

// A partner's share of one store's profit, set by the admin per store. The admin owner
// always receives the rest of that store's profit (100% minus the store's partner shares),
// and 100% of stores without partners. A partner can hold different shares in several stores.
model StoreProfitShare {
  id              String   @id @default(uuid())
  storeId         String
  ownerId         String
  sharePercent    Decimal  @db.Decimal(7, 4)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([storeId, ownerId])
  @@index([storeId])
  @@map("store_profit_shares")
}

model OwnerTransaction {
  id                  String               @id @default(uuid())
  ownerId             String
  type                OwnerTransactionType
  amountUsd           Decimal              @db.Decimal(14, 2)
  exchangeRate        Decimal              @db.Decimal(10, 4)
  sourceOrDestination String?
  createdByUserId     String
  note                String?
  createdAt           DateTime             @default(now())

  owner Owner @relation(fields: [ownerId], references: [id])

  @@index([ownerId, createdAt])
  @@map("owner_transactions")
}

model QuarterClosure {
  id             String   @id @default(uuid())
  quarterName    String
  closedByUserId String
  snapshot       Json
  closedAt       DateTime @default(now())

  @@map("quarter_closures")
}

model ExchangeRate {
  id              String    @id @default(uuid())
  date            String    @unique
  rate            Decimal   @db.Decimal(10, 4)
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedByUserId String?
  updatedAt       DateTime?

  @@map("exchange_rates")
}

model Notification {
  id           String    @id @default(uuid())
  title        String
  message      String
  targetType   String?
  targetId     String?
  targetRoute  String?
  targetRole   Role?
  targetUserId String?
  read         Boolean   @default(false)
  resolved     Boolean   @default(false)
  readAt       DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  // Structured facts of the business event behind an admin notification (all optional, so
  // older notifications stay valid): what happened, where, who did it, the money and the document.
  actionType   String?
  storeId      String?
  storeName    String?
  actorUserId  String?
  actorName    String?
  amountTjs    Decimal?  @db.Decimal(14, 2)
  amountUsd    Decimal?  @db.Decimal(14, 2)
  documentRef  String?
  details      Json?
  // One notification per business event: a retried request finds the existing row.
  dedupeKey    String?   @unique

  user User? @relation(fields: [targetUserId], references: [id])

  @@index([targetUserId, read])
  @@index([targetRole, read])
  @@index([targetUserId, createdAt])
  @@index([targetRole, createdAt])
  @@index([actionType, createdAt])
  @@index([storeId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id               String   @id @default(uuid())
  userId           String?
  userName         String?
  userRole         String?
  storeName        String?
  action           String
  details          String
  financialDetails Json?
  imei             String?
  receiptNumber    Int?
  targetId         String?
  ipAddress        String?
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([targetId])
  @@map("audit_logs")
}

model LedgerEntry {
  id           String     @id @default(uuid())
  type         LedgerType
  description  String
  amountTjs    Decimal?   @db.Decimal(14, 2)
  amountUsd    Decimal?   @db.Decimal(14, 2)
  exchangeRate Decimal?   @db.Decimal(10, 4)
  storeId      String?
  storeName    String?
  userName     String?
  referenceId  String?
  createdAt    DateTime   @default(now())

  @@index([createdAt])
  @@map("ledger_entries")
}

// Unified financial ledger (Phase 1 of the finance module). Every account
// (per-store cash register + the company-wide Main Account) has its balance
// mutated only alongside a FinancialTransaction row in the same DB transaction —
// see server/src/modules/finance. LedgerEntry above is left untouched by this
// system; it keeps recording exactly what it always has.
model FinancialAccount {
  id                String               @id @default(uuid())
  name              String
  type              FinancialAccountType
  // One CASH account per store (nullable+unique so MAIN/OTHER accounts have no store).
  storeId           String?              @unique
  active            Boolean              @default(true)
  openingBalanceTjs Decimal              @default(0) @db.Decimal(14, 2)
  openingBalanceUsd Decimal              @default(0) @db.Decimal(14, 2)
  // Cached running balance, kept in sync transactionally by financial-transaction.service.ts —
  // not derived by summing FinancialTransaction rows at read time.
  balanceTjs        Decimal              @default(0) @db.Decimal(14, 2)
  balanceUsd        Decimal              @default(0) @db.Decimal(14, 2)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  store                   Store?                 @relation(fields: [storeId], references: [id])
  transactions            FinancialTransaction[] @relation("AccountTransactions")
  destinationTransactions FinancialTransaction[] @relation("DestinationAccountTransactions")

  @@map("financial_accounts")
}

model FinancialCategory {
  id        String             @id @default(uuid())
  name      String
  direction FinancialDirection
  parentId  String?
  // System categories are wired to automatic postings (sales, supplier payments, ...)
  // and can't be deleted from the UI; admins may still create/edit custom categories.
  isSystem  Boolean            @default(false)
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())

  parent       FinancialCategory?     @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     FinancialCategory[]    @relation("CategoryHierarchy")
  transactions FinancialTransaction[]

  @@map("financial_categories")
}

model FinancialTransaction {
  id                String                     @id @default(uuid())
  transactionNumber String                     @unique
  type              FinancialTransactionType
  direction         FinancialDirection
  status            FinancialTransactionStatus @default(POSTED)
  transactionDate   DateTime                   @default(now())

  accountId            String
  // TRANSFER only — the account money moved into.
  destinationAccountId String?

  // Original amount/currency as entered, plus the frozen-at-creation TJS/USD
  // equivalents — same "snapshot the rate, never recompute later" contract every
  // other money model in this schema already follows.
  amount          Decimal        @db.Decimal(14, 2)
  currency        String
  exchangeRate    Decimal?       @db.Decimal(10, 4)
  amountTjs       Decimal        @db.Decimal(14, 2)
  amountUsd       Decimal        @db.Decimal(14, 2)
  // Which balance column this row actually moved on `account`/`destinationAccount` — see enum doc.
  balanceCurrency LedgerCurrency

  categoryId       String?
  // Loose reference (not a FK) since the target table depends on counterpartyType —
  // mirrors the existing unenforced-string-ref convention used by sourceAccount/
  // createdByUserId across SupplierPayment/Expense/OwnerTransaction.
  counterpartyType CounterpartyType?
  counterpartyId   String?
  counterpartyName String?

  shopId                String?
  // Business document that generated this row, e.g. "SALE" / "EXPENSE" / "SUPPLIER_PAYMENT".
  sourceType            String?
  sourceId              String?
  // Set on a reversal transaction; points back to the transaction it reverses.
  reversedTransactionId String? @unique
  // Stripe-style idempotency: the client generates this once per logical attempt (form
  // open / confirm-dialog open) and resends it unchanged on any retry. Nullable+unique
  // (like FinancialAccount.storeId) — Postgres allows unlimited NULLs, so callers that
  // omit it are unaffected. See finance.service.ts for the pre-check + P2002-recovery.
  idempotencyKey        String? @unique

  description String
  comment     String?

  createdByUserId   String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  cancelledAt       DateTime?
  cancelledByUserId String?

  account            FinancialAccount   @relation("AccountTransactions", fields: [accountId], references: [id])
  destinationAccount FinancialAccount?  @relation("DestinationAccountTransactions", fields: [destinationAccountId], references: [id])
  category           FinancialCategory? @relation(fields: [categoryId], references: [id])
  shop               Store?             @relation(fields: [shopId], references: [id])

  @@index([transactionDate])
  @@index([accountId])
  @@index([shopId])
  @@index([sourceType, sourceId])
  @@index([categoryId])
  @@index([counterpartyType, counterpartyId])
  @@index([status])
  @@map("financial_transactions")
}

// Atomic per-prefix-per-year counter backing FinancialTransaction.transactionNumber
// (e.g. key "CR-2026" -> next receipt number). Incremented via a single
// UPDATE ... RETURNING so concurrent requests can never receive the same number.
model DocumentSequence {
  key       String @id
  nextValue Int    @default(1)

  @@map("document_sequences")
}
