# APP_URL: Allowed web origins (comma-separated). Production Compose also appends
# capacitor://localhost and https://localhost for the configured native shells.
# For a non-Compose native backend deployment append those origins yourself.
APP_URL="http://localhost:3000"

# DATABASE_URL: Local Docker PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5435/mobile_shop_db?schema=public"


JWT_SECRET="local-dev-only-secret-do-not-use-in-prod-3f8a9c2e1b6d4f70"

# Business day boundaries (exchange rates, reports). Default Asia/Tashkent. If you change it,
# build the frontend with the same VITE_BUSINESS_TIME_ZONE so date filters match the server.
# BUSINESS_TIME_ZONE="Asia/Tashkent"
# VITE_BUSINESS_TIME_ZONE="Asia/Tashkent"

# Backend server API port
PORT="3001"

# Required only when creating these users for the first time (16+ characters each).
# Existing passwords are never changed by seed. Do not commit real values.
# SEED_PASSWORD_ADMIN=
# SEED_PASSWORD_PARTNER=
# SEED_PASSWORD_AHMAD=
# SEED_PASSWORD_FARHOD=

