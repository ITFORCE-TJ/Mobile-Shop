{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue.bold,green.bold \"npm run server\" \"npm run dev:frontend\"",
    "dev:frontend": "vite --port=3000 --host=0.0.0.0",
    "dev:backend": "npm run server",
    "build": "vite build",
    "build:native": "vite build --mode native",
    "native:sync": "npm run build:native && cap sync",
    "native:ios": "cap open ios",
    "native:android": "cap open android",
    "postinstall": "prisma generate",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx scripts/test-e2e-all.ts",
    "test:profit-refund": "tsx scripts/test-profit-share-refund.ts",
    "test:audit-fixes": "tsx scripts/test-audit-fixes.ts",
    "test:functional": "tsx scripts/test-functional-audit.ts",
    "audit:system": "tsx scripts/audit-system.ts",
    "audit:owners": "tsx scripts/check-owner-balances.ts",
    "db:clean": "tsx scripts/clear-data-keep-users.ts",
    "server": "tsx watch server/src/index.ts"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "8.2.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/status-bar": "8.0.3",
    "@prisma/client": "^6.12.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.546.0",
    "prisma": "^6.12.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "tsx": "^4.21.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.5",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
